{
	"$schema": "./package.schema.json",
	"name": "obsidian-html-preview",
	"version": "1.0.9",
	"description": "Render HTML code blocks as live, sandboxed webpages inside Obsidian notes.",
	"main": "main.js",
	"author": "sunshinelife83",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sunshinelife83/obsidian-html-preview.git"
	},
	"bugs": {
		"url": "https://github.com/sunshinelife83/obsidian-html-preview/issues"
	},
	"homepage": "https://github.com/sunshinelife83/obsidian-html-preview#readme",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "npm run typecheck && npm test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"html",
		"preview"
	],
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "0.25.8",
		"jsdom": "26.1.0",
		"obsidian": "1.8.7",
		"tslib": "2.6.2",
		"typescript": "5.9.2",
		"vitest": "3.2.7"
	}
}
